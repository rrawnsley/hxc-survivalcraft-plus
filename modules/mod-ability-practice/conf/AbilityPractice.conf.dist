# Development feature. Disabled by default; enable only on an isolated test server.
# Both flags and a valid enrollment mode are required on an isolated test server.
# The numerical training profile is illustrative, not approved production balance.
AbilityPractice.Enable = 0
AbilityPractice.AllowDevelopmentObservation = 0

# Comma-separated character database GUIDs, at most 128 positive uint32 IDs (example: "12, 34").
# In selected-character mode, empty or malformed selection disables all development effects.
# Reloadable. Removed characters keep their saved progress/learned ranks and return to native progression.
AbilityPractice.DevelopmentCharacterGuids = ""

# Automatically enroll new human characters from selected CoA classes (12 through 32).
# Set the minimum GUID once to the next character ID before opening the pilot. Existing IDs stay native.
# Reloadable; both fields must be configured together. Explicit character selection can coexist.
# Malformed fields disable enrollment. Realm-wide enrollment cannot coexist with this selection.
AbilityPractice.DevelopmentNewCharacterClassIds = ""
AbilityPractice.DevelopmentNewCharacterMinimumGuid = "0"

# Optional enrollment for all existing/future characters whose class has a loaded practice profile.
# Startup-only, disabled by default; use only on an isolated server until runtime qualification.
# Requires both enable flags, valid native data and an empty DevelopmentCharacterGuids setting.
# A nonempty or malformed character selection disables effects in realm mode. Saved progress is retained.
AbilityPractice.AllowDevelopmentRealmEnrollment = 0

# Additional experimental rank gating and automatic upgrades. Leave off for observation-only sessions.
AbilityPractice.AllowDevelopmentRankLearning = 0

# Additional representative class-grant fixtures for all 21 CoA classes. Read once at startup.
# The default catalog remains the original three Pyromancer fixtures. Neither catalog is production balance.
AbilityPractice.AllowDevelopmentClassSamples = 0

# Expanded unapproved ranked class-grant catalog. Read once at startup; takes priority over class samples.
# All definitions use draft practice balance and still require effective native startup validation.
AbilityPractice.AllowDevelopmentRankedCatalog = 0

# Experimental original-cast observation of native periodic damage and healing. Read once at startup.
# Adds Cindergrip, Shadra's Prayer, Harvest Plague, Deathwind, Condemn and Decomposition.
# Leave off until isolated qualification; scripted spread/copies cannot earn extra practice.
AbilityPractice.AllowDevelopmentPeriodicObservation = 0

# Experimental individually authored healing/direct damage mastery, up to 2% in PvE. Startup-only.
# Includes Hand of Elune, Vile Sting, Soulslam, Dreadrider Stomp, Hellfire Trample, Pommel Smash and Lunge.
# This applies draft healing/damage benefits when observation is enabled; it is not observation-only.
AbilityPractice.AllowDevelopmentMastery = 0

# Experimental original-cast observation of Manafeed's scripted drain-and-heal result. Startup-only.
# This adds its ranked development profile; other scripted/helper abilities remain unsupported.
AbilityPractice.AllowDevelopmentScriptedObservation = 0

# Optional native utility catalog: recall/teleport and reviewed resurrection rank ladders. Startup-only.
# They keep normal acquisition/full function and earn no practice. No training bar or invented ranks.
AbilityPractice.AllowDevelopmentFixedCatalog = 0

# Optional three reviewed Horde Fel Rift trainer abilities. Startup-only, disabled by default.
# Loaded trainer ownership/levels and native rift mappings must match. No practice or automatic teaching.
AbilityPractice.AllowDevelopmentTrainerFixedCatalog = 0

# Optional catch-up for neglected abilities. Startup-only, unapproved development balance.
# Boost practice when proficiency is at least Gap behind the current cap; stop below that gap.
# Gap must be 1-500 and multiplier 2-4 when enabled. No saved progress is retroactively multiplied.
AbilityPractice.AllowDevelopmentCatchup = 0
AbilityPractice.DevelopmentCatchupGap = 40
AbilityPractice.DevelopmentCatchupMultiplier = 2

# Experimental Emerald Veil actual school-absorption observation. Startup-only; disabled by default.
# Adds/reuses its six-rank Healing profile. Direct healing and actual PvE shielding share one original-cast award.
# No shield magnitude, native mechanics or mastery benefit changes. Other shields and mana shields unsupported.
AbilityPractice.AllowDevelopmentAbsorption = 0

# Enable isolated Storm Alert fear and Headbutt/Battle Rush/Cindergrip control credit at startup.
# Original casts must newly control an eligible PvE enemy; damage and control share one award.
AbilityPractice.AllowDevelopmentControlObservation = 0

# Optional per-ability ranked pacing curves targeting 30-60 combat minutes under draft cadence assumptions.
# Startup-only. Uses definition version2 and exact fraction-preserving conversion from the reviewed version1.
# Effective use frequency, cooldown exceptions and gameplay migration still need isolated qualification.
# Turning this off after version2 progress exists preserves the row but does not downgrade it to version1.
AbilityPractice.AllowDevelopmentRankPacing = 0

# One upcoming rank may be prepared; its character-level unlock opens practice toward the following rank.
# Startup-only definition4 requires rank pacing. Earned proficiency and learned ranks remain preserved.
# Disabling the option preserves version4 rows without downgrading them to older definitions.
AbilityPractice.AllowDevelopmentOneRankAhead = 0

# Optional milestone pacing for Hand of Elune, Vile Sting and Soulslam. Startup-only; mastery must be enabled.
# Definition version2 preserves earned proficiency/rewards and rebases the reviewed version1 partial fraction.
# Draft raw/cadence assumptions target45 minutes per benefit before catch-up; runtime qualification is pending.
# Disabling this does not downgrade version2 rows; unknown definitions remain preserved and unavailable.
AbilityPractice.AllowDevelopmentMasteryPacing = 0

# Experimental original direct health-leech damage practice for Bloodbolt, Ravenous Strike and Titanstrike.
# Actual PvE damage earns one shared original-cast use; self healing earns no additional use.
AbilityPractice.AllowDevelopmentDirectLeech = 0

# Experimental thirteen reviewed stat-buff tracks; combat casts practice buffs you applied to yourself.
# Requires development rank pacing and trainer rank extensions for the complete seven-rank ladder.
# Each buff has separate application provenance and a5s practice floor; applications alone earn nothing.
AbilityPractice.AllowDevelopmentBuffContribution = 0

# Development-only reviewed item-conjuring utilities retain native ranks and learning. Startup-only.
# Rejuvenating Mojo, Brew Stew/Cocktail, Thunder Ale and Bone Reliquary have no practice counter or gate.
AbilityPractice.AllowDevelopmentConjureFixedCatalog = 0

# Development-only complete trainer-linked rank extensions. Requires rank pacing; startup-only.
# Selected authored profiles move to definition3 with guarded readable version1/2 migration.
AbilityPractice.AllowDevelopmentTrainerRankExtensions = 0

# Development-only reviewed class passive roadmap. Startup-only; native grants and full effects remain.
# No practice counter, proficiency gate, automatic teaching or authored mastery benefit.
AbilityPractice.AllowDevelopmentPassiveFixedCatalog = 0

# Development-only reviewed unranked interrupts, cleanses and spell steals. Startup-only.
# Native unlocks/full utility remain; no practice counter, gate, automatic teaching or authored benefit.
# Smash Lock and Melt Lock retain native lock requirements and existing conditional skill progression.
AbilityPractice.AllowDevelopmentUtilityFixedCatalog = 0

# Draft reviewed unranked fear, stun and root utility roadmap. Startup-only; full native function.
# No practice counter, gate, automatic teaching or authored cooldown/duration benefit.
AbilityPractice.AllowDevelopmentControlFixedCatalog = 0

# Reviewed Greater Wuju and Ranger adaptations share their regular tracks. Startup-only; development mode.
AbilityPractice.AllowDevelopmentSharedBuffVariants = 0

# Authored ranked resource/combo spenders award additional points per meaningful use.
# Requires rank pacing and one-rank-ahead caps. Startup-only; prior saved progress is retained.
AbilityPractice.AllowDevelopmentResourcePacing = 0
