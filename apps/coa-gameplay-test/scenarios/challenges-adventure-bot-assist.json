{
  "schema": 1,
  "name": "Adventure Mode companions can assist and pull for their group leader",
  "contract": "Grouped playerbot companions use their human leader's restricted challenge for creature tapping. They can attack a creature first tapped by their leader, and the leader can attack one first tapped by a companion. Bots in another group and unrelated humans still cannot attack either group's restricted tap.",
  "timeout_ms": 180000,
  "location": { "map": 0, "x": -8914.0, "y": -133.0, "z": 80.6 },
  "players": [
    { "id": "leader", "race": 1, "class": 1, "level": 1 },
    { "id": "companion", "race": 1, "class": 1, "level": 1, "bot": true },
    { "id": "outsider", "race": 1, "class": 1, "level": 1 },
    { "id": "foreign_bot", "race": 1, "class": 1, "level": 1, "bot": true }
  ],
  "creatures": [
    { "id": "leader_wolf", "owner": "leader", "entry": 299, "faction": 7, "level": 1,
      "health": 1000, "distance": 2 },
    { "id": "companion_wolf", "owner": "companion", "entry": 299, "faction": 7, "level": 1,
      "health": 1000, "distance": 2 }
  ],
  "steps": [
    { "action": "wait", "ms": 5000 },
    { "action": "start_challenge", "actor": "leader", "challenge": 211, "level": 1 },
    { "action": "wait", "ms": 1500 },
    { "action": "assert", "actor": "leader", "metric": "challenge_start_code", "equals": 0 },
    { "action": "group", "actor": "leader", "target": "companion" },
    { "action": "group", "actor": "outsider", "target": "foreign_bot" },
    { "action": "attack", "actor": "leader", "target": "leader_wolf" },
    { "action": "assert", "actor": "leader", "metric": "melee_attack_count", "min": 1,
      "within_ms": 10000 },
    { "action": "stop_attack", "actor": "leader" },
    { "action": "attack", "actor": "companion", "target": "leader_wolf" },
    { "action": "assert", "label": "the companion attacks its leader's restricted tap",
      "actor": "companion", "metric": "victim", "target": "leader_wolf", "equals": 1 },
    { "action": "assert", "actor": "companion", "metric": "melee_attack_count", "min": 1,
      "within_ms": 10000 },
    { "action": "stop_attack", "actor": "companion" },
    { "action": "client_packet", "actor": "foreign_bot", "opcode": 321, "consumed": false,
      "fields": [ { "actor_guid": "leader_wolf" } ] },
    { "action": "wait", "ms": 500 },
    { "action": "assert", "label": "a bot from another group remains excluded",
      "actor": "foreign_bot", "metric": "system_message_contains",
      "text": "already tapped by another challenge", "equals": 1 },
    { "action": "attack", "actor": "companion", "target": "companion_wolf" },
    { "action": "wait", "ms": 3000 },
    { "action": "assert", "label": "a companion's pull retains Adventure Mode difficulty",
      "actor": "companion_wolf", "metric": "max_health", "equals": 2000 },
    { "action": "stop_attack", "actor": "companion" },
    { "action": "attack", "actor": "leader", "target": "companion_wolf" },
    { "action": "assert", "label": "the leader attacks its companion's restricted tap",
      "actor": "leader", "metric": "victim", "target": "companion_wolf", "equals": 1 },
    { "action": "stop_attack", "actor": "leader" },
    { "action": "client_packet", "actor": "outsider", "opcode": 321, "consumed": false,
      "fields": [ { "actor_guid": "companion_wolf" } ] },
    { "action": "wait", "ms": 500 },
    { "action": "assert", "label": "a human outsider cannot use a bot's tap to bypass Adventure Mode",
      "actor": "outsider", "metric": "system_message_contains",
      "text": "already tapped by another challenge", "equals": 1 }
  ]
}
